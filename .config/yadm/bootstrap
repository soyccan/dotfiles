#!/bin/bash -x
set -o errexit
set -o nounset
set -o pipefail
shopt -s nullglob
if (( BASH_VERSINFO[0] > 4 ||
      (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) ))
then
    shopt -s inherit_errexit
fi
_PS4_FILE=${BASH_SOURCE[0]:-$(hostname)}
_PS4_FILE=${_PS4_FILE##*/}
PS4='\e[32m+${_PS4_FILE}:${LINENO}>\e[0m '  # green
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Configuration
DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/soyccan/dotfiles.git}"
DOTFILES_BRANCH="${DOTFILES_BRANCH:-yadm}"

main() {
    # Bootstrap phase: ensure yadm and dotfiles are set up
    bootstrap_yadm

    # Main setup phase
    install_packages || true
    setup_docker || true
    setup_fish || true

    echo Voila! Setup Finished!
}

bootstrap_yadm() {
    echo "=== Bootstrapping YADM and Dotfiles ==="

    # Check if yadm is installed, if not install it
    if ! has yadm; then
        echo "YADM not found, installing..."
        install_yadm_bootstrap
    fi

    # Check if dotfiles repo is already cloned
    if yadm rev-parse --git-dir &>/dev/null; then
        echo "YADM repo already initialized"
        # Update existing repo
        yadm pull || echo "Warning: Failed to update dotfiles repo"
    else
        echo "Cloning dotfiles repository..."
        clone_dotfiles
    fi

    # Update SCRIPT_DIR to point to the actual yadm directory
    SCRIPT_DIR="${HOME}/.config/yadm"
}

install_yadm_bootstrap() {
    echo "Installing YADM..."

    if is_ubuntu && apt show yadm &>/dev/null; then
        sudo apt update
        sudo apt install -y yadm
    elif is_macos && has brew; then
        brew install yadm
    else
        install_yadm_from_github
    fi
}

install_yadm_from_github() {
    echo "Installing YADM from GitHub..."
    mkdir -p "${HOME}/.local/bin"
    curl -fsSL https://github.com/TheLocehiliosan/yadm/raw/master/yadm -o "${HOME}/.local/bin/yadm"
    chmod +x "${HOME}/.local/bin/yadm"

    # Add to PATH if not already there
    if [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
        export PATH="${HOME}/.local/bin:${PATH}"
    fi
}

clone_dotfiles() {
    echo "Cloning dotfiles from ${DOTFILES_REPO} (branch: ${DOTFILES_BRANCH})..."

    # Initialize yadm and clone the repo
    yadm clone "${DOTFILES_REPO}" --branch "${DOTFILES_BRANCH}" --no-bootstrap

    # Checkout the files (this will overwrite conflicts)
    # yadm checkout -- .

    echo "Dotfiles cloned successfully"
}

install_packages() {
    if is_ubuntu; then
        install_packages_ubuntu
    elif is_macos; then
        install_packages_macos
    fi
    install_packages_common
}

install_packages_ubuntu() {
    echo Installing Packages

    add_apt_sources
    sudo apt update

    local pkgs pkgs_avail pkgs_as_regex
    pkgs=(
        # docker-ce
        # ubuntu-standard
        bat
        bear
        eza
        fasd
        fastfetch
        fd-find
        fish
        fzf
        gdu
        git
        git-delta
        htop
        httpie
        iftop
        jq
        lbzip2
        mypy
        neovim
        nmap
        p7zip-full
        pigz
        pixz
        python3-ipython
        python3-venv
        ranger
        repo
        ripgrep
        shellcheck
        shfmt
        tealdeer
        tig
        tree-sitter-cli
        unzip
        yadm
    )

    # tmake dependencies
    pkgs+=(
        binfmt-support
        debhelper
        libssl-dev
        python3-dev
        qemu-user-binfmt
        qemu-user-static
        swig
        zstd
    )

    # some packages may not be available on all systems
    pkgs_as_regex=$(IFS="|"; echo "${pkgs[*]}")
    readarray -t pkgs_avail < <(apt-cache --generate pkgnames | grep -E "^(${pkgs_as_regex})$")
    # install or update
    sudo apt install -y --ignore-missing "${pkgs_avail[@]}"

    # On Ubuntu bat is installed as batcat. Link the original name to it.
    mkdir -p "${HOME}/.local/bin"
    if ! has bat && has batcat; then
        ln -sf "$(command -v batcat)" "${HOME}/.local/bin/bat"
    fi
}

add_apt_sources() {
    local distro codename arch aptsrc_file aptsrc_x64 aptsrc_arm64

    distro=$(to_lower "$(lsb_release --id --short 2>/dev/null)")
    codename=$(lsb_release --codename --short)
    arch=$(get_arch_deb)

    # if ! curl -fsSL "https://download.docker.com/linux/${distro}/dists/${codename}/stable/binary-${arch}/" &>/dev/null; then
    #     # fallback
    #     distro=debian
    #     codename=bookworm
    # fi

    aptsrc_x64=
    aptsrc_arm64=

    if [[ -e "/etc/apt/sources.list.d/ubuntu.sources" ]]; then
        # Ubuntu 24.04 and later uses DEB822 format
        aptsrc_file=/etc/apt/sources.list.d/ubuntu.sources
    else
        aptsrc_file=/etc/apt/sources.list
    fi

    if [[ "$(resolvectl domain)" == *"nvidia.com"* ]]; then
        aptsrc_x64=https://urm.nvidia.com/artifactory/ubuntu-remote/
    elif [[ "$(get_country)" == TW ]]; then
        aptsrc_x64=http://mirror.twds.com.tw/ubuntu/
        aptsrc_arm64=https://mirror.twds.com.tw/ubuntu-ports/
    fi

    if [[ "${arch}" == "amd64" && "${aptsrc_x64}" != "" ]]; then
        sudo perl -p -i -e \
            "s#http://(archive|security)\.ubuntu\.com/ubuntu/?#${aptsrc_x64}#g" \
            "${aptsrc_file}"
    fi

    if [[ "${arch}" == "arm64" && "${aptsrc_arm64}" != "" ]]; then
        sudo perl -p -i -e \
            "s#http://ports\.ubuntu\.com/ubuntu-ports/?#${aptsrc_arm64}#g" \
            "${aptsrc_file}"
    fi

    # Apply apt sources
    for f in "${HOME}"/.config/apt/sources.list.d/*; do
        (
            export distro codename arch
            envsubst < "${f}" | sudo tee "/etc/apt/sources.list.d/${f##*/}" >/dev/null
        )
    done

    for f in "${HOME}"/.config/apt/keyrings/*; do
        sudo cp -fv "${f}" "/usr/share/keyrings/${f##*/}"
    done
}

install_packages_macos() {
    echo Installing packages for macOS

    local pkgs pkg
    pkgs=(
        # docker
        # fasd
        # wezterm
        bat
        bear
        coreutils
        eza
        fastfetch
        fd
        fish
        fzf
        gdu
        git
        git-delta
        htop
        iftop
        jq
        lazydocker
        lazygit
        neovim
        nmap
        python3
        ranger
        repo
        ripgrep
        shfmt
        starship
        tealdeer
        unzip
        uv
        yadm
        zoxide
    )
    for pkg in "${pkgs[@]}"; do
        brew install "${pkg}" || true
    done
}

install_packages_common() {
    install_jj || true
    install_just || true
    install_lazydocker || true
    install_lazygit || true
    install_starship || true
    install_uv || true
    install_zoxide || true

    local pip_pkgs pkg
    pip_pkgs=(
        #pre-commit
        #ruff
        #shell-gpt
    )
    for pkg in "${pip_pkgs[@]}"; do
        "${HOME}/.local/bin/uv" tool install "${pkg}" || true
    done
}

get_latest_release_version() {
    local repo=$1
    local default_version=$2
    if ! curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" \
        | perl -ne 'print $1 if /"tag_name":\s*"v?(.*?)"/'
    then
        echo "${default_version}"
    fi
}

install_fonts() {
    local version
    version=$(get_latest_release_version tonsky/FiraCode 6.2)

    curl -fsSL "https://github.com/tonsky/FiraCode/releases/download/${version}/Fira_Code_v${version}.zip" \
        | unzip -d "${HOME}/.local/share/fonts/FireCode/"

    fc-cache -f -v
}

install_helix() {
    local version
    version=$(get_latest_release_version helix-editor/helix 25.07.1)

    if has hx && [[ $(hx --version) == *${version}* ]]; then
        return
    fi

    curl -fsSL "https://github.com/helix-editor/helix/releases/download/${version}/helix-${version}-$(get_arch_uname)_$(to_lower "$(get_os)").tar.xz" \
        | tar -C "${HOME}/opt" -xJf -
    ln -sf "${HOME}/opt/helix-${version}-$(get_arch_uname)-$(to_lower "$(get_os)")/hx" "${HOME}/.local/bin/hx"
}

install_jj() {
    local version
    version=$(get_latest_release_version jj-vcs/jj 0.42.0)

    if has jj && [[ $(jj --version) == *${version}* ]]; then
        return
    fi

    curl -fsSL "https://github.com/jj-vcs/jj/releases/download/v${version}/jj-v${version}-$(get_arch_uname)-unknown-linux-musl.tar.gz" \
        | tar -C "${HOME}/.local/bin" -xzf - ./jj
}

install_lazydocker() {
    local version
    version=$(get_latest_release_version jesseduffield/lazydocker 0.24.2)

    if has lazydocker && [[ $(lazydocker --version) == *${version}* ]]; then
        return
    fi

    curl -fsSL "https://github.com/jesseduffield/lazydocker/releases/download/v${version}/lazydocker_${version}_$(to_lower "$(get_os)")_$(get_arch_uname).tar.gz" \
        | tar -C "${HOME}/.local/bin" -xzf - lazydocker
}

install_lazygit() {
    local version
    version=$(get_latest_release_version jesseduffield/lazygit 0.57.0)

    if has lazygit && [[ $(lazygit --version) == *${version}* ]]; then
        return
    fi

    curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${version}/lazygit_${version}_$(to_lower "$(get_os)")_$(get_arch_uname).tar.gz" \
        | tar -C "${HOME}/.local/bin" -xzf - lazygit
}

install_just() {
    local version
    version=$(get_latest_release_version casey/just 1.45.0)

    if has just && [[ $(just --version 2>/dev/null) == *${version}* ]]; then
        return
    fi

    local os arch
    os=$(get_os)
    arch=$(get_arch_uname)

    # Map architecture names to just's naming convention
    case "${arch}" in
        arm64|aarch64) arch="aarch64" ;;
    esac

    # Map OS to just's naming convention
    local platform
    case "${os}" in
        Darwin) platform="apple-darwin" ;;
        Linux) platform="unknown-linux-musl" ;;
        *) echo "Unsupported OS: ${os}"; return 1 ;;
    esac

    local url="https://github.com/casey/just/releases/download/${version}/just-${version}-${arch}-${platform}.tar.gz"
    echo "Downloading just from: ${url}"
    curl -fsSL "${url}" | tar -C "${HOME}/.local/bin" -xzf - just
}

install_starship() {
    local version
    version=$(get_latest_release_version starship/starship 1.24.1)

    if has starship && [[ $(starship --version) == *${version}* ]]; then
        return
    fi

    sh <(curl -fsSL https://starship.rs/install.sh) --yes --bin-dir "${HOME}/.local/bin"
}

install_uv() {
    local version
    version=$(get_latest_release_version astral-sh/uv 0.9.18)

    if has uv && [[ $(uv --version) == *${version}* ]]; then
        return
    fi

    sh <(curl -fsSL https://astral.sh/uv/install.sh)
}

install_zoxide() {
    local version
    version=$(get_latest_release_version ajeetdsouza/zoxide 0.9.8)

    if has zoxide && [[ $(zoxide --version) == *${version}* ]]; then
        return
    fi

    sh <(curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh)
}

setup_docker() {
    echo Configuring Docker

    if ! has docker || ! getent group docker >/dev/null; then
        return
    fi

    sudo usermod --append --groups docker "${USER}"
}

setup_fish() {
    echo Configuring Fish Shell

    if is_macos; then
        # Changing shell requires sudo and can modify system files.
        # On macOS, we prefer to do it manually.
        return
    fi

    shell=/usr/bin/fish

    if [[ ! -e $shell ]]; then
        return
    fi

    sudo chsh -s $shell "${USER}"
}

setup_ufw() {
    echo Configuring UFW

    if ! has ufw; then
        return
    fi

    tmpdir=$(mktemp --directory)
    mkdir -p "${tmpdir}"
    git clone https://github.com/ageis/ufw-application-profiles "${tmpdir}"
    sudo cp -nrv "${tmpdir}/applications.d/"* /etc/ufw/applications.d

    echo '

# ---

# BEGIN UFW AND DOCKER
*filter
:ufw-user-forward - [0:0]
:ufw-docker-logging-deny - [0:0]
:DOCKER-USER - [0:0]

# allow traffic within the same bridge
-A DOCKER-USER -m physdev --physdev-is-bridged -j RETURN

# consult ufw forward rules
-A DOCKER-USER -j ufw-user-forward

-A DOCKER-USER -p udp -m udp --sport 53 --dport 1024:65535 -j RETURN

-A DOCKER-USER -j ufw-docker-logging-deny -p tcp -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -d 192.168.0.0/16
-A DOCKER-USER -j ufw-docker-logging-deny -p tcp -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -d 10.0.0.0/8
-A DOCKER-USER -j ufw-docker-logging-deny -p tcp -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -d 172.16.0.0/12
-A DOCKER-USER -j ufw-docker-logging-deny -p udp -m udp --dport 0:32767 -d 192.168.0.0/16
-A DOCKER-USER -j ufw-docker-logging-deny -p udp -m udp --dport 0:32767 -d 10.0.0.0/8
-A DOCKER-USER -j ufw-docker-logging-deny -p udp -m udp --dport 0:32767 -d 172.16.0.0/12

-A ufw-docker-logging-deny -m limit --limit 3/min --limit-burst 10 -j LOG --log-prefix "[UFW DOCKER BLOCK] "
-A ufw-docker-logging-deny -j DROP

COMMIT
# END UFW AND DOCKER' | sudo tee -a /etc/ufw/after.rules >/dev/null
}

passwdless_sudo() {
    cat <<EOF | sudo tee /etc/sudoers.d/ubuntu >/dev/null
# User rules for ubuntu
ubuntu ALL=(ALL) NOPASSWD:ALL

# avoid password for sudo -v
Defaults:ubuntu !authenticate
EOF
}


# Utility functions

has() {
    command -v "${1}" &>/dev/null
}

to_lower() {
    echo "${1,,}"
}

is_package_installed_ubuntu() {
    dpkg-query --show --showformat='${Status}' "${1}" 2>/dev/null | grep -q "ok installed"
}

is_ubuntu() {
    [[ $(get_os) == Linux &&
        ( $(lsb_release --id --short 2>/dev/null) == Ubuntu ||
          $(lsb_release --id --short 2>/dev/null) == Kali ) ]]
}

is_macos() {
    [[ $(get_os) == Darwin ]]
}

get_os() {
    uname -s
}

# Returns uname-style arch (x86_64, aarch64, armv7l).
# Use for GitHub release URLs that follow kernel naming conventions.
get_arch_uname() {
    uname -m
}

# Returns Debian/dpkg-style arch (amd64, arm64, armhf, armel).
# Use for apt sources and any tooling that follows Debian naming conventions.
get_arch_deb() {
    local arch
    arch=$(get_arch_uname)
    case "${arch}" in
        x86_64)        echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7l|armv6l) echo "armhf" ;;
        armv5*)        echo "armel" ;;
        i386|i686)     echo "i386" ;;
        *)             echo "${arch}" ;;
    esac
}

get_country() {
    curl -s "https://ipinfo.io/$(curl -s ifconfig.me)/country"
}

# Compare two semantic version strings
semver_cmp() {
    local vers1=$1
    local vers2=$2

    # Split the versions into parts (major, minor, patch)
    IFS='.' read -r -a parts1 <<< "$vers1"
    IFS='.' read -r -a parts2 <<< "$vers2"

    # Compare each part of the semantic version
    for i in {0..2}; do
        # Default missing parts to 0
        local part1=${parts1[i]:-0}
        local part2=${parts2[i]:-0}

        if (( part1 < part2 )); then
            echo -1
            return
        elif (( part1 > part2 )); then
            echo 1
            return
        fi
    done

    # If all parts are equal, return 0
    echo 0
}

semver_lt() {
    (( $(semver_cmp "${1}" "${2}") < 0 ))
}

semver_le() {
    (( $(semver_cmp "${1}" "${2}") <= 0 ))
}

# Entry point

if [[ ${BASH_SOURCE[0]} = "${0}" ]]; then
    # if this script is being executed instead of being sourced
    main
fi
